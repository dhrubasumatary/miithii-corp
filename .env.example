# MIITHII dev credentials template — copy to .env (gitignored) and fill in
# ADMIN = postgres role (migrations, provisioning). RUNTIME = miithii_app role (RLS-enforced; created by miithii-engine/scripts/provision_app_role.py)
# Session pooler (IPv4, session mode — preserves RLS session vars). Do NOT use :6543 transaction pooler.
DATABASE_URL_ADMIN=postgresql://postgres.PROJECTREF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://miithii_app.PROJECTREF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
GEMINI_API_KEY=
OPENROUTER_API_KEY=
